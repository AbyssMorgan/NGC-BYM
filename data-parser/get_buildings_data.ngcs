function extract_array(string $content, string $name) : array {
    $content = preg_replace('~//.*$~m', '', $content);
    if(!preg_match('/"'.preg_quote($name, '/').'"\s*:\s*\[(.*?)\]/s', $content, $match)){
        return [];
    }
    preg_match_all('/-?\d+/', $match[1], $values);
    return array_map('intval', $values[0]);
}

function parse_building(string $file) : object {
	$content = file_get_contents($file);
	preg_match('/"id"\s*:\s*(\d+)/', $content, $id);
	return (object)[
		'id' => isset($id[1]) ? (int)$id[1] : null,
		'hp' => extract_array($content, 'hp'),
		'repair_time' => extract_array($content, 'repairTime'),
	];
}

$buildings = [];

foreach($files as $file){
	$meta = parse_building($this->core->get_path("../client/scripts/buildings/yard/$file"));
	$buildings[$meta->id] = (object)[
		'hp' => $meta->hp,
		'repair_time' => $meta->repair_time,
	];
}
file_put_contents("buildings.json", json_encode($buildings));
